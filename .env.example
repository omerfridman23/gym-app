# Neon Postgres — pooled connection, used by the API at runtime
DATABASE_URL=

# Neon Postgres — direct connection. Used by migrations AND at runtime by the
# privileged client (public confirm/pay links and the reminders worker, which
# both run without a coach in context). The API will not boot without it.
DATABASE_URL_UNPOOLED=

# Signing key for the session cookie. Required — the API refuses to boot
# without it. Use a long random string, e.g. `openssl rand -base64 32`.
JWT_SECRET=

# API
PORT=3000
# Comma-separated list of allowed web origins. In production this is also the
# origin embedded in client-facing confirm/pay links, so it must be the real
# public URL of the web app, not localhost.
WEB_ORIGIN=http://localhost:5173
DATABASE_POOL_MAX=10
# Privileged pool for public links, OTP and reminder-worker queries.
# Keep the combined app + admin pools within the database connection limit.
DATABASE_ADMIN_POOL_MAX=10

# Temporary fixed login for demos without an SMS provider. Keep false in
# production unless access with code 1111 is intentionally required.
DEV_LOGIN_ENABLED=false

# SMS — "dev" logs the OTP; "twilio" / "019" send a real SMS.
# Production defaults to twilio and reads credentials from the settings table.
SMS_DRIVER=dev

# Optional Twilio env fallback (preferred store is settings in the DB).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

# Auto-send session reminders on WhatsApp (off until the WhatsApp sender is set).
REMINDERS_ENABLED=false

# Optional 019 credentials (only when SMS_DRIVER=019).
SMS_019_USERNAME=
SMS_019_TOKEN=
SMS_019_SOURCE=

# Automatic reminders spend money; the rest are safe to leave unset.
# REMINDERS_POLL_SECONDS=300
# REMINDERS_MAX_PER_RUN=50
# REMINDERS_MAX_ATTEMPTS=3
# REMINDERS_RETRY_MINUTES=15
# REMINDERS_QUIET_START_HOUR=22
# REMINDERS_QUIET_END_HOUR=8
