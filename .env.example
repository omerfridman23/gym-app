# Neon Postgres — pooled connection, used by the API at runtime
DATABASE_URL=

# Neon Postgres — direct connection, used only for migrations
DATABASE_URL_UNPOOLED=

# API
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_POOL_MAX=10

# SMS — "dev" logs the OTP to the API console; "019" or "twilio" send a real SMS.
# Production defaults to "019" and refuses to start without that driver's vars.
SMS_DRIVER=dev

# 019 SMS gateway (019sms.co.il) — the production default.
SMS_019_USERNAME=
SMS_019_TOKEN=
SMS_019_SOURCE=

# Twilio (alternative; set SMS_DRIVER=twilio to use).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
